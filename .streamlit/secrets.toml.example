# Template for Streamlit Community Cloud secrets.
#
# Local development does NOT need this file — .env (loaded via python-dotenv)
# already covers local runs. This file documents what to paste into the
# Streamlit Cloud app's Settings -> Secrets text box when deploying.
#
# Copy this content, fill in real values, and paste it into the Secrets UI.
# Do NOT commit a filled-in secrets.toml to the repo.

MONGODB_URI = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0"
REDUCTO_API_KEY = "<reducto-api-key>"
GOOGLE_CLOUD_PROJECT = "<gcp-project-id>"
GOOGLE_CLOUD_REGION = "us-central1"
VERTEX_ENDPOINT_NAME = ""
GEMINI_MODEL = "gemini-2.5-flash"

# Paste the full contents of service_account.json as an inline TOML table:
[GOOGLE_SERVICE_ACCOUNT_JSON]
type = "service_account"
project_id = "<gcp-project-id>"
private_key_id = "<key-id>"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "<service-account-email>"
client_id = "<client-id>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "<cert-url>"
universe_domain = "googleapis.com"
